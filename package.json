{
  "name": "godot-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Godot Engine integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && tsc",
    "build:css": "npx tailwindcss -i ./public/styles/input.css -o ./public/styles/output.css --minify",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "web-ui": "node dist/web-ui.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "godot",
    "game-engine",
    "ai",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "alpinejs": "^3.15.8",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "undici": "^7.2.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
